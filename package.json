{
  "name": "skymood-theme",
  "displayName": "Skymood — Adaptive Day/Night Theme",
  "description": "A living color theme, in dark and light, that shifts with your day, plus playful touches: a glow when you are in the flow, a soft red pulse when new errors appear, confetti when your errors hit zero, golden hour at sunset and the moon phase at night.",
  "version": "1.2.0",
  "publisher": "mvnandhakumar",
  "author": {
    "name": "Nandha Kumar"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#17141f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nandha65/skymood-theme"
  },
  "bugs": {
    "url": "https://github.com/Nandha65/skymood-theme/issues"
  },
  "homepage": "https://github.com/Nandha65/skymood-theme#readme",
  "sponsor": {
    "url": "https://github.com/sponsors/Nandha65"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "light theme",
    "adaptive",
    "day night",
    "skymood",
    "blue light",
    "night shift",
    "sunset",
    "auto theme",
    "playful",
    "flow state",
    "moon phase",
    "golden hour",
    "fun",
    "confetti",
    "errors"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Skymood Adaptive",
        "uiTheme": "vs-dark",
        "path": "./themes/skymood-adaptive.json"
      },
      {
        "label": "Skymood Night",
        "uiTheme": "vs-dark",
        "path": "./themes/skymood-night.json"
      },
      {
        "label": "Skymood Dawn",
        "uiTheme": "vs-dark",
        "path": "./themes/skymood-dawn.json"
      },
      {
        "label": "Skymood Day",
        "uiTheme": "vs-dark",
        "path": "./themes/skymood-day.json"
      },
      {
        "label": "Skymood Dusk",
        "uiTheme": "vs-dark",
        "path": "./themes/skymood-dusk.json"
      },
      {
        "label": "Skymood Adaptive Light",
        "uiTheme": "vs",
        "path": "./themes/skymood-adaptive-light.json"
      },
      {
        "label": "Skymood Night Light",
        "uiTheme": "vs",
        "path": "./themes/skymood-night-light.json"
      },
      {
        "label": "Skymood Dawn Light",
        "uiTheme": "vs",
        "path": "./themes/skymood-dawn-light.json"
      },
      {
        "label": "Skymood Daylight",
        "uiTheme": "vs",
        "path": "./themes/skymood-daylight.json"
      },
      {
        "label": "Skymood Dusk Light",
        "uiTheme": "vs",
        "path": "./themes/skymood-dusk-light.json"
      }
    ],
    "commands": [
      {
        "command": "skymood.enable",
        "title": "Turn On Adaptive Theme",
        "category": "Skymood"
      },
      {
        "command": "skymood.previewCycle",
        "title": "Preview a Full Day",
        "category": "Skymood"
      },
      {
        "command": "skymood.pickPhase",
        "title": "Pin a Phase / Follow the Sun",
        "category": "Skymood"
      },
      {
        "command": "skymood.setLocation",
        "title": "Set Location for Sunrise & Sunset",
        "category": "Skymood"
      },
      {
        "command": "skymood.togglePlayful",
        "title": "Toggle Playful Effects",
        "category": "Skymood"
      },
      {
        "command": "skymood.celebrate",
        "title": "Celebrate!",
        "category": "Skymood"
      },
      {
        "command": "skymood.removeOverrides",
        "title": "Remove Adaptive Overrides from Settings",
        "category": "Skymood"
      },
      {
        "command": "skymood.menu",
        "title": "Open Menu",
        "category": "Skymood"
      }
    ],
    "configuration": {
      "title": "Skymood",
      "properties": {
        "skymood.appearance": {
          "type": "string",
          "enum": [
            "dark",
            "light",
            "system"
          ],
          "enumItemLabels": [
            "Dark",
            "Light",
            "System default"
          ],
          "enumDescriptions": [
            "Skymood Adaptive: deep sky colors.",
            "Skymood Adaptive Light: the same four moods on paper.",
            "Follow your OS: dark when your OS is dark, light when it's light. Turns on VS Code's window.autoDetectColorScheme."
          ],
          "default": "dark",
          "order": 0,
          "markdownDescription": "Dark, light, or follow your OS (**System default**). Switches right away while Skymood is your theme. Choosing Dark or Light turns off `window.autoDetectColorScheme` if it was on; System default turns it on."
        },
        "skymood.mode": {
          "type": "string",
          "enum": [
            "clock",
            "solar"
          ],
          "enumDescriptions": [
            "Use the fixed sunrise and sunset times below.",
            "Calculate real sunrise and sunset from your latitude and longitude (offline)."
          ],
          "default": "clock",
          "description": "How Skymood decides when day and night begin."
        },
        "skymood.sunrise": {
          "type": "string",
          "default": "06:30",
          "pattern": "^\\d{1,2}:\\d{2}$",
          "description": "Sunrise time (HH:MM, 24h) used in clock mode."
        },
        "skymood.sunset": {
          "type": "string",
          "default": "18:30",
          "pattern": "^\\d{1,2}:\\d{2}$",
          "description": "Sunset time (HH:MM, 24h) used in clock mode."
        },
        "skymood.latitude": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": -90,
          "maximum": 90,
          "description": "Latitude for solar mode. Stays on your machine."
        },
        "skymood.longitude": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": -180,
          "maximum": 180,
          "description": "Longitude for solar mode. Stays on your machine."
        },
        "skymood.nightWarmth": {
          "type": "number",
          "default": 0.4,
          "minimum": 0,
          "maximum": 1,
          "description": "How much blue light to remove at night (0 = none, 1 = strongest)."
        },
        "skymood.pinnedPhase": {
          "type": "string",
          "enum": [
            "auto",
            "night",
            "dawn",
            "day",
            "dusk"
          ],
          "default": "auto",
          "description": "Follow the sun automatically, or pin one phase."
        },
        "skymood.updateIntervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "How often the palette is refreshed."
        },
        "skymood.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the current phase in the status bar."
        },
        "skymood.playful.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Master switch for all playful effects."
        },
        "skymood.playful.flowGlow": {
          "type": "boolean",
          "default": true,
          "description": "Accent colors glow brighter the longer you type without a break (5, 15 and 30 minutes)."
        },
        "skymood.playful.bugMood": {
          "type": "boolean",
          "default": true,
          "description": "The editor and status bar tint subtly warmer as errors pile up in your open files."
        },
        "skymood.playful.errorPulse": {
          "type": "boolean",
          "default": true,
          "description": "When new errors appear in your open files and stay for a few seconds, the editor slowly fades to a soft red and back, twice. At most once every 30 seconds. Skipped when workbench.reduceMotion is on."
        },
        "skymood.playful.celebrate": {
          "type": "boolean",
          "default": true,
          "description": "Celebrate when you fix the last error in your open files. The more errors you fixed, the bigger the party."
        },
        "skymood.playful.confetti": {
          "type": "boolean",
          "default": true,
          "description": "Confetti and a pop-up badge over the editor when you celebrate, and a badge at flow milestones. Skipped when workbench.reduceMotion is on (the status bar still cheers)."
        },
        "skymood.playful.goldenHour": {
          "type": "boolean",
          "default": true,
          "description": "A warm golden shimmer around sunrise and sunset."
        },
        "skymood.playful.moonPhase": {
          "type": "boolean",
          "default": true,
          "description": "Show tonight’s moon phase, with a silver moonlight accent on full-moon nights."
        }
      }
    }
  },
  "scripts": {
    "build:themes": "node scripts/build-themes.js",
    "vscode:prepublish": "node scripts/build-themes.js",
    "package": "npx @vscode/vsce package",
    "publish": "npx @vscode/vsce publish"
  }
}
